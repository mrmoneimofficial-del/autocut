{
  "name": "autocut",
  "version": "1.0.0",
  "private": true,
  "description": "قصّاص — قص الصمت من الفيديو بأقصى سرعة",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^14.0.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}